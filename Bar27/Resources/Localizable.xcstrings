    "Ou cliquez sur « + » sous la liste et choisissez Bar27. Validez si macOS le demande ; Bar27 bascule tout seul.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or click “+” below the list and choose Bar27. Confirm if macOS asks; Bar27 switches over on its own."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ou cliquez sur « + » sous la liste et choisissez Bar27. Validez si macOS le demande ; Bar27 bascule tout seul."
